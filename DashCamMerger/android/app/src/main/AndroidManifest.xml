<?xml version="1.0" encoding="utf-8"?>
<!-- No storage permissions: the user grants access to one folder via the system picker (SAF). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AR-13: keep a merge running with the screen off / app in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AR-13.2: Samsung freezes optimised apps ~2 min after screen-off, even with a FGS. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DashCamMerger">
        <activity
            android:name=".android.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".android.MergeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
